rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    // Check if the user is signed in with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the signed-in user has the admin role in users/{uid} or is the primary owner
    function isAdmin() {
      return isAuthenticated() && (
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        ) ||
        request.auth.token.email == "aishfitness8@gmail.com"
      );
    }

    // Validate incoming public lead application submissions
    function isValidApplication(data) {
      return
        // Required core fields must be present
        data.keys().hasAll([
          'fullName',
          'contactNumber',
          'email',
          'selectedPackage',
          'packageId',
          'status',
          'createdAt'
        ]) &&
        // Only allow expected application fields (no arbitrary injected data)
        data.keys().hasOnly([
          'fullName',
          'contactNumber',
          'email',
          'selectedPackage',
          'packageId',
          'batchTiming',
          'ageWeightHeight',
          'fitnessGoal',
          'gymExperience',
          'cardioHistory',
          'strengths',
          'weakPoints',
          'gymTimings',
          'activityLevel',
          'dietPreference',
          'dislikedFoods',
          'weeklyMealBudget',
          'alcoholSmoke',
          'healthConditions',
          'status',
          'createdAt'
        ]) &&
        // Status must always initialize to "new" on public creation
        data.status == "new" &&
        // Data type and length validations
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200 &&
        data.contactNumber is string && data.contactNumber.size() >= 5 && data.contactNumber.size() <= 50 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.selectedPackage is string && data.selectedPackage.size() <= 150 &&
        data.packageId is string && data.packageId.size() <= 50;
    }

    // =========================================================================
    // USER ROLES & ACCESS CONTROL
    // =========================================================================
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // PUBLIC SITE CONTENT (Hero, Workshop, Pricing, Brand, Certifications, etc.)
    // =========================================================================
    
    match /site_content/{docId} {
      // Public visitors can read the live public site configuration
      allow read: if true;
      // Authenticated admin users can update the live site configuration
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // CLIENT TRANSFORMATIONS GALLERY
    // =========================================================================
    
    match /transformations/{transId} {
      // Public visitors can view documented client transformations
      allow read: if true;
      // Authenticated admin users can add, update, or delete transformations
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // LEADS & APPLICATIONS (Sensitive Applicant Dossiers)
    // =========================================================================
    
    match /applications/{applicationId} {
      // Public visitors can submit an application with strict schema validation
      allow create: if isValidApplication(request.resource.data);
      // Authenticated admin users can view, update, or delete leads
      allow read, update, delete: if isAuthenticated();
    }

    // =========================================================================
    // DEFAULT DENY ALL OTHER COLLECTIONS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
